# ProductDoc-Agentic-RAG environment template
# Copy this file to .env and fill in secrets and service-specific endpoints.

# LLM: any OpenAI-compatible chat or vision endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Compatibility alias used by legacy import utilities.
OPENAI_API_BASE=
LLM_DEFAULT_MODEL=
VL_MODEL=
LLM_DEFAULT_TEMPERATURE=0.1

# Document parsing service
MINERU_BASE_URL=
MINERU_API_TOKEN=

# Local embedding and reranker models
BGE_M3_PATH=./models/BAAI/bge-m3
BGE_M3=BAAI/bge-m3
BGE_M3_CACHE_DIR=./models
BGE_RERANKER_CACHE_DIR=./models
BGE_DEVICE=cpu
BGE_FP16=False
BGE_RERANKER_LARGE=BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False

# Milvus vector database
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=knowledge_chunks
ITEM_NAME_COLLECTION=item_names

# MongoDB history and memory
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=productdoc_rag

# MinIO object storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_PDF_DIR=pdf_files
MINIO_IMG_DIR=upload-images
MINIO_SECURE=False

# Optional WebSearch MCP endpoint
MCP_DASHSCOPE_BASE_URL=

# Checkpoint, trace and logging
CHECKPOINT_ENABLED=True
QUERY_TRACE_PATH=logs/query_trace.jsonl
# Context selection: ranked (baseline), budgeted, or item_balanced (upstream item_names).
CONTEXT_SELECTION_POLICY=ranked
# Candidate cap for each confirmed item in item_balanced mode; total context remains bounded.
CONTEXT_PER_ITEM_K=20
# Experimental planner query decomposition; maximum three subqueries, default off.
SUBQUERY_RETRIEVAL_ENABLED=False
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=False
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days

# Redis is optional. When disabled or unavailable, task state falls back to memory.
REDIS_ENABLED=False
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=rag
REDIS_TASK_TTL_SECONDS=86400
REDIS_UPLOAD_LOCK_TTL_SECONDS=3600
REDIS_SOCKET_TIMEOUT_SECONDS=1.0

# RQ is optional. When disabled or unavailable, imports fall back to FastAPI BackgroundTasks.
RQ_ENABLED=False
RQ_IMPORT_QUEUE_NAME=rag-import
RQ_JOB_TIMEOUT_SECONDS=3600
RQ_RESULT_TTL_SECONDS=86400
RQ_FAILURE_TTL_SECONDS=604800
